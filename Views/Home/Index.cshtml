@model IEnumerable<Book>
@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-5 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold">BookSwap</h1>
    <p class="fs-5 text-muted">
        Give your old books a second life. Find used books near you or sell the ones you have already read.
    </p>
    <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg me-2">Browse books</a>
    <a asp-controller="Books" asp-action="Create" class="btn btn-outline-success btn-lg">Sell a book</a>
</div>

<h2 class="mb-4">Latest books</h2>

@if (!Model.Any())
{
    <p class="text-muted">No books yet.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var book in Model)
        {
            <partial name="_BookCard" model="book" />
        }
    </div>
}